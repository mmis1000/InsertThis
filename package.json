{
  "name": "insert-this",
  "displayName": "Insert this",
  "version": "0.1.1",
  "description": "Insert file as import statement into current opened file.",
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmis1000/InsertThis.git"
  },
  "license": "MIT",
  "author": {
    "name": "mmis1000",
    "email": "mmis10002@gmail.com",
    "url": "https://mmis1000.me/"
  },
  "publisher": "mmis1000-personal",
  "main": "./dist/extension.js",
  "icon": "icon.png",
  "scripts": {
    "compile-all": "npm run --include-workspace-root --workspaces compile",
    "watch-all": "npm-run-all -p watch watch:plugin",
    "compile": "webpack",
    "compile-tests": "tsc -p . --outDir out",
    "just-test": "node ./out/test/runTest.js",
    "lint": "eslint src",
    "package": "webpack --mode production --devtool hidden-source-map",
    "pretest": "npm run compile-tests && npm run compile-all && npm run lint",
    "test": "npm run test-compile && npm run just-test",
    "test-compile": "tsc -p ./ && npm run compile-all",
    "test:update-snapshot": "npm run test-compile && cross-env UPDATE_SNAPSHOT=1 npm run just-test  ",
    "vscode:prepublish": "npm run --include-workspace-root --workspaces package",
    "watch": "webpack --watch",
    "watch:plugin": "npm run --workspace=insert-this-tsc-plugin watch",
    "watch-tests": "tsc -p . -w --outDir out",
    "webpack": "webpack --mode none"
  },
  "contributes": {
    "typescriptServerPlugins": [
      {
        "name": "insert-this-tsc-plugin"
      }
    ],
    "commands": [
      {
        "command": "insert-this.testTscCommand",
        "title": "Test TSC Plugin"
      },
      {
        "command": "insert-this.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "insert-this.insertThisFile",
        "title": "Insert this file"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "insert-this.insertThisFile",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "insert-this.insertThisFile"
        }
      ]
    },
    "configuration": {
      "title": "Insert This",
      "properties": {
        "insertThis.jsxTemplateStringByFileExtension": {
          "type": "object",
          "order": 11,
          "default": {
            "*": "<img src={${1:$VARIABLE_NAME}} alt=\"\" />$0",
            "[svg][jpg][jpeg][png][gif][webp]": "<img src={${1:$VARIABLE_NAME}} alt=\"\" />$0",
            "[mp4]": "<video src={${1:$VARIABLE_NAME}} />$0",
            "[ts][tsx][js][jsx][mts][mtsx][mjs][mjsx][cts][ctsx][cjs][cjsx]": "<${1:$VARIABLE_NAME}></${1:$VARIABLE_NAME}>$0"
          },
          "description": "template when insert string into JSX element by file extension",
          "$comment": "setting for well known image types",
          "properties": {},
          "patternProperties": {
            "^\\*$|^(\\[[^\\[\\]]*\\])+$": {
              "type": "string"
            }
          },
          "required": [
            "*"
          ],
          "additionalProperties": false
        },
        "insertThis.jsxTemplateStringWithImageSizeByFileExtension": {
          "type": "object",
          "order": 11,
          "default": {
            "[svg][jpg][jpeg][png][gif][webp]": "<img src={$VARIABLE_NAME} width=\"$IMAGE_WIDTH\" height=\"$IMAGE_HEIGHT\" alt=\"\" />"
          },
          "description": "template when insert image with size into JSX element by file extension",
          "$comment": "setting for well known image types",
          "properties": {},
          "patternProperties": {
            "^\\*$|^(\\[[^\\[\\]]*\\])+$": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "insertThis.variableSuffixByFileExtension": {
          "type": "object",
          "order": 21,
          "default": {
            "*": "",
            "[svg][jpg][jpeg][png][gif][webp]": "img",
            "[mp4]": "video"
          },
          "description": "suffix when add import by file extension, for example `fileName[Img]`",
          "$comment": "setting for well known image types",
          "properties": {},
          "patternProperties": {
            "^\\*$|^(\\[[^\\[\\]]*\\])+$": {
              "type": "string"
            }
          },
          "required": [
            "*"
          ],
          "additionalProperties": false
        },
        "insertThis.variableNameRuleByFileExtension": {
          "type": "object",
          "order": 22,
          "$comment": "setting default for well known js files",
          "default": {
            "*": "camel",
            "[ts][tsx][js][jsx][mts][mtsx][mjs][mjsx][cts][ctsx][cjs][cjsx]": "pascal"
          },
          "description": "naming rule for generated variable, either camel or pascal",
          "properties": {},
          "patternProperties": {
            "^\\*$|^(\\[[^\\[\\]]*\\])+$": {
              "type": "string",
              "enum": [
                "camel",
                "pascal"
              ]
            }
          },
          "required": [
            "*"
          ],
          "additionalProperties": false
        }
      }
    }
  },
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact"
  ],
  "extensionDependencies": [
    "vscode.typescript-language-features"
  ],
  "dependencies": {
    "@ungap/structured-clone": "^1.3.0",
    "image-size": "^2.0.1",
    "insert-this-tsc-plugin": "file:./packages/insert-this-tsc-plugin",
    "strip-ansi-cjs": "npm:strip-ansi@^6.0.1"
  },
  "devDependencies": {
    "@types/chai": "^4.3.19",
    "@types/istanbul-lib-instrument": "^1.7.7",
    "@types/istanbul-lib-report": "^3.0.3",
    "@types/istanbul-lib-source-maps": "^4.0.4",
    "@types/istanbul-reports": "^3.0.4",
    "@types/mocha": "^10.0.7",
    "@types/node": "20.x",
    "@types/ungap__structured-clone": "^1.2.0",
    "@types/vscode": "^1.93.0",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "chai": "^4.5.0",
    "copy-webpack-plugin": "^12.0.2",
    "cross-env": "^7.0.3",
    "eslint": "^9.9.1",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-instrument": "^6.0.3",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-lib-source-maps": "^5.0.6",
    "istanbul-reports": "^3.1.7",
    "mocha-chai-jest-snapshot": "^1.1.6",
    "mocha-multi-reporters": "^1.5.1",
    "npm-run-all": "^4.1.5",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.4",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4"
  },
  "engines": {
    "vscode": "^1.97.0"
  },
  "workspaces": [
    "packages/insert-this-tsc-plugin"
  ],
  "vsce": {
    "followSymlinks": true
  }
}
